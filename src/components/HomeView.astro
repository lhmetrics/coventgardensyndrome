---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import StoryCard from './StoryCard.astro';
import LangSwitcher from './LangSwitcher.astro';
import { ui } from '../i18n/ui';
import { locales, type Locale } from '../i18n/locales';
import { getHomePath } from '../i18n/paths';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];

const stories = (await getCollection('stories', ({ id }) => id.startsWith(`${lang}/`))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const alternates = Object.fromEntries(locales.map((l) => [l, getHomePath(l)])) as Record<
  Locale,
  string
>;
---

<Layout
  title={`Covent Garden Syndrome — ${t.tagline}`}
  description={t.manifesto[0]}
  lang={lang}
  alternates={alternates}
>
  <header class="hero">
    <img class="hero-photo" src="/photos/hero.jpg" alt="" />
    <div class="hero-scrim"></div>
    <LangSwitcher lang={lang} />
    <div class="hero-text">
      <h1 class="brand">{t.kicker}</h1>
      <p class="tagline">{t.tagline}</p>
    </div>
  </header>

  <section class="manifesto">
    {t.manifesto.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <main class="content">
    {
      stories.length > 0 ? (
        <section class="grid">
          {stories.map((story) => {
            const slug = story.id.slice(lang.length + 1);
            return (
              <StoryCard
                lang={lang}
                slug={slug}
                title={story.data.title}
                date={story.data.date}
                excerpt={story.data.excerpt}
                cover={story.data.cover}
              />
            );
          })}
        </section>
      ) : (
        <p class="empty">{t.empty}</p>
      )
    }
  </main>

  <footer class="footer">
    <p>{t.footer(new Date().getFullYear())}</p>
  </footer>
</Layout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(88vh, 46rem);
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(14, 13, 11, 0.95) 0%,
      rgba(14, 13, 11, 0.55) 40%,
      rgba(14, 13, 11, 0.15) 70%
    );
  }

  .hero-text {
    position: relative;
    width: 100%;
    max-width: 44rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 3.5rem;
    text-align: center;
  }

  .brand {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    color: var(--turquoise);
    letter-spacing: 0.01em;
  }

  .tagline {
    margin: 1.4em 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ink-dim);
  }

  .manifesto {
    max-width: 38rem;
    margin: 0 auto;
    padding: 4.5rem 1.5rem;
    text-align: center;
  }

  .manifesto p {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--ink-dim);
    margin: 0 0 1.4em;
  }

  .manifesto p:first-child::before {
    content: '“';
    font-style: normal;
    color: var(--accent);
  }

  .manifesto p:last-child {
    margin-bottom: 0;
    color: var(--ink);
  }

  .manifesto p:last-child::after {
    content: '”';
    font-style: normal;
    color: var(--accent);
  }

  .content {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 2.5rem 2rem;
  }

  .empty {
    text-align: center;
    color: var(--ink-dim);
    padding: 3rem 0;
  }

  .footer {
    border-top: 1px solid var(--rule);
    padding: 2rem 1.5rem;
    text-align: center;
    color: var(--ink-dim);
    font-size: 0.85rem;
  }
</style>
