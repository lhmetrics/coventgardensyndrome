---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import StoryCard from './StoryCard.astro';
import LangSwitcher from './LangSwitcher.astro';
import SectionsMenu from './SectionsMenu.astro';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
import { getHomePath } from '../i18n/paths';
import { sections, type SectionId } from '../i18n/sections';

interface Props {
  lang: Locale;
  sectionId: SectionId;
}

const { lang, sectionId } = Astro.props;
const t = ui[lang];
const section = sections[sectionId][lang];

// Default matches the homepage policy (oldest first). A CSS-only :target
// toggle (no JS) lets the reader flip to newest-first — both orders are
// pre-rendered and only one is shown at a time, see the .grid-* rules below.
const storiesOldestFirst = (
  await getCollection(
    'stories',
    ({ id, data }) => id.startsWith(`${lang}/`) && data.section === sectionId,
  )
).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const storiesNewestFirst = [...storiesOldestFirst].reverse();

function renderCard(story: (typeof storiesOldestFirst)[number]) {
  const slug = story.id.slice(lang.length + 1);
  return {
    lang,
    slug,
    title: story.data.title,
    date: story.data.date,
    excerpt: story.data.excerpt,
    cover: story.data.cover,
  };
}
---

<Layout
  title={`${section.title} — Covent Garden Syndrome`}
  description={section.description}
  lang={lang}
>
  <SectionsMenu lang={lang} />
  <LangSwitcher lang={lang} />

  <header class="section-hero">
    <p class="emoji">{section.emoji}</p>
    <h1>{section.title}</h1>
    <p class="description">{section.description}</p>
  </header>

  <main class="content">
    <div class="toolbar">
      <a class="back" href={getHomePath(lang)}>
        {t.back}
      </a>
      {storiesOldestFirst.length > 1 && (
        <nav class="sort" aria-label={t.sortLabel}>
          <a class="sort-link" href="#oldest-first">
            {t.sortOldestFirst}
          </a>
          <a class="sort-link" href="#newest-first">
            {t.sortNewestFirst}
          </a>
        </nav>
      )}
    </div>

    <span id="oldest-first" class="sort-target" />
    <span id="newest-first" class="sort-target" />

    {
      storiesOldestFirst.length > 0 ? (
        <>
          <section class="grid grid-oldest">
            {storiesOldestFirst.map((story) => (
              <StoryCard {...renderCard(story)} />
            ))}
          </section>
          <section class="grid grid-newest">
            {storiesNewestFirst.map((story) => (
              <StoryCard {...renderCard(story)} />
            ))}
          </section>
        </>
      ) : (
        <p class="empty">{t.sectionsEmpty}</p>
      )
    }
  </main>

  <footer class="footer">
    <p>{t.footer(new Date().getFullYear())}</p>
  </footer>
</Layout>

<style>
  .section-hero {
    max-width: 38rem;
    margin: 0 auto;
    padding: 6rem 1.5rem 2.5rem;
    text-align: center;
  }

  .emoji {
    font-size: 2.5rem;
    margin: 0 0 0.5em;
  }

  .section-hero h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
  }

  .description {
    margin: 1em 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--ink-dim);
  }

  .content {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem 1.5rem 5rem;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: 2.5rem;
  }

  .back {
    color: var(--ink-dim);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back:hover {
    color: var(--ink);
  }

  .sort {
    display: flex;
    gap: 0.6rem;
  }

  .sort-link {
    padding: 0.35em 0.9em;
    border: 1px solid var(--rule);
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-dim);
    font-size: 0.8rem;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .sort-link:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  /* CSS-only sort toggle, no JS: both orders are always in the DOM, and
     :target (driven by the #oldest-first / #newest-first links above)
     picks which one is visible. Default (no hash, or #oldest-first) shows
     the oldest-first grid; jumping to #newest-first swaps them. */
  .sort-target {
    display: block;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .grid {
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 2.5rem 2rem;
  }

  .grid-oldest {
    display: grid;
  }

  .grid-newest {
    display: none;
  }

  #newest-first:target ~ .grid-oldest {
    display: none;
  }

  #newest-first:target ~ .grid-newest {
    display: grid;
  }

  .empty {
    text-align: center;
    color: var(--ink-dim);
    padding: 3rem 0;
  }

  .footer {
    border-top: 1px solid var(--rule);
    padding: 2rem 1.5rem;
    text-align: center;
    color: var(--ink-dim);
    font-size: 0.85rem;
  }
</style>
