---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import StoryCard from './StoryCard.astro';
import LangSwitcher from './LangSwitcher.astro';
import SectionsMenu from './SectionsMenu.astro';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
import { getHomePath } from '../i18n/paths';
import { sections, type SectionId } from '../i18n/sections';

interface Props {
  lang: Locale;
  sectionId: SectionId;
}

const { lang, sectionId } = Astro.props;
const t = ui[lang];
const section = sections[sectionId][lang];

const stories = (
  await getCollection(
    'stories',
    ({ id, data }) => id.startsWith(`${lang}/`) && data.section === sectionId,
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title={`${section.title} — Covent Garden Syndrome`}
  description={section.description}
  lang={lang}
>
  <SectionsMenu lang={lang} />
  <LangSwitcher lang={lang} />

  <header class="section-hero">
    <p class="emoji">{section.emoji}</p>
    <h1>{section.title}</h1>
    <p class="description">{section.description}</p>
  </header>

  <main class="content">
    <a class="back" href={getHomePath(lang)}>{t.back}</a>

    {
      stories.length > 0 ? (
        <section class="grid">
          {stories.map((story) => {
            const slug = story.id.slice(lang.length + 1);
            return (
              <StoryCard
                lang={lang}
                slug={slug}
                title={story.data.title}
                date={story.data.date}
                excerpt={story.data.excerpt}
                cover={story.data.cover}
              />
            );
          })}
        </section>
      ) : (
        <p class="empty">{t.sectionsEmpty}</p>
      )
    }
  </main>

  <footer class="footer">
    <p>{t.footer(new Date().getFullYear())}</p>
  </footer>
</Layout>

<style>
  .section-hero {
    max-width: 38rem;
    margin: 0 auto;
    padding: 6rem 1.5rem 2.5rem;
    text-align: center;
  }

  .emoji {
    font-size: 2.5rem;
    margin: 0 0 0.5em;
  }

  .section-hero h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
  }

  .description {
    margin: 1em 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--ink-dim);
  }

  .content {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem 1.5rem 5rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 2.5rem;
    color: var(--ink-dim);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back:hover {
    color: var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 2.5rem 2rem;
  }

  .empty {
    text-align: center;
    color: var(--ink-dim);
    padding: 3rem 0;
  }

  .footer {
    border-top: 1px solid var(--rule);
    padding: 2rem 1.5rem;
    text-align: center;
    color: var(--ink-dim);
    font-size: 0.85rem;
  }
</style>
