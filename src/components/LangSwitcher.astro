---
import { locales, localeLabels, type Locale } from '../i18n/locales';
import { getHomePath, getSectionPath, getStoryPath } from '../i18n/paths';
import type { SectionId } from '../i18n/sections';

interface Props {
  lang: Locale;
  // Section pages: sections are a fixed taxonomy that exists in every
  // locale, so switching language can always deep-link to the same
  // section's page in the target locale.
  sectionId?: SectionId;
  // Story pages: a story doesn't necessarily exist in all 3 locales (see
  // repo CLAUDE.md), so the caller must say which locales this slug is
  // actually available in — switching to any other locale falls back to
  // that locale's homepage instead of a missing page.
  storySlug?: string;
  availableLocales?: readonly Locale[];
}

const { lang, sectionId, storySlug, availableLocales } = Astro.props;

function hrefFor(l: Locale) {
  if (sectionId) return getSectionPath(l, sectionId);
  if (storySlug && availableLocales?.includes(l)) return getStoryPath(l, storySlug);
  return getHomePath(l);
}
---

<nav class="lang-switch" aria-label="Language">
  {
    locales.map((l) => (
      <a href={hrefFor(l)} aria-current={l === lang ? 'page' : undefined}>
        {localeLabels[l]}
      </a>
    ))
  }
</nav>

<style>
  .lang-switch {
    position: fixed;
    top: 1.25rem;
    right: 1.5rem;
    z-index: 10;
    display: flex;
    gap: 0.9rem;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  .lang-switch a {
    text-decoration: none;
    color: var(--ink-dim);
  }

  .lang-switch a[aria-current='page'] {
    color: var(--ink);
    border-bottom: 1px solid var(--accent);
  }
</style>
