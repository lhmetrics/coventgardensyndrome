---
import { localeTags, type Locale } from '../i18n/locales';
import { getStoryPath } from '../i18n/paths';
import SectionBadge from './SectionBadge.astro';
import type { SectionId } from '../i18n/sections';

interface Props {
  lang: Locale;
  slug: string;
  title: string;
  date: Date;
  excerpt?: string;
  cover?: string;
  section?: SectionId;
}

const { lang, slug, title, date, excerpt, cover, section } = Astro.props;

const formattedDate = date.toLocaleDateString(localeTags[lang], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const href = getStoryPath(lang, slug);
---

<div class="card">
  <a class="cover-link" href={href} tabindex="-1">
    <div class="cover" class:list={{ placeholder: !cover }}>
      {cover && <img src={cover} alt="" loading="lazy" />}
    </div>
  </a>
  <div class="body">
    <p class="date">{formattedDate}</p>
    {section && <SectionBadge lang={lang} sectionId={section} />}
    <a class="title-link" href={href}>
      <h3 class="title">{title}</h3>
    </a>
    {excerpt && <p class="excerpt">{excerpt}</p>}
  </div>
</div>

<style>
  .cover-link,
  .title-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .cover {
    aspect-ratio: 4 / 3;
    background: var(--bg-raised);
    overflow: hidden;
    border: 1px solid var(--rule);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card:hover .cover img {
    transform: scale(1.03);
  }

  .cover.placeholder {
    background: linear-gradient(135deg, #1c1a14, #0e0d0b 65%);
    position: relative;
  }

  .cover.placeholder::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--rule);
  }

  .date {
    margin: 0.9em 0 0.25em;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .title {
    font-size: 1.25rem;
  }

  .title-link:hover .title {
    color: var(--accent);
  }

  .excerpt {
    margin: 0.5em 0 0;
    color: var(--ink-dim);
    font-size: 0.95rem;
  }
</style>
