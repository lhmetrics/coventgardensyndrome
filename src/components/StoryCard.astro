---
import { localeTags, type Locale } from '../i18n/locales';
import { getStoryPath } from '../i18n/paths';

interface Props {
  lang: Locale;
  slug: string;
  title: string;
  date: Date;
  excerpt?: string;
  cover?: string;
}

const { lang, slug, title, date, excerpt, cover } = Astro.props;

const formattedDate = date.toLocaleDateString(localeTags[lang], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<a class="card" href={getStoryPath(lang, slug)}>
  <div class="cover" class:list={{ placeholder: !cover }}>
    {cover && <img src={cover} alt="" loading="lazy" />}
  </div>
  <div class="body">
    <p class="date">{formattedDate}</p>
    <h3 class="title">{title}</h3>
    {excerpt && <p class="excerpt">{excerpt}</p>}
  </div>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .cover {
    aspect-ratio: 4 / 3;
    background: var(--bg-raised);
    overflow: hidden;
    border: 1px solid var(--rule);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card:hover .cover img {
    transform: scale(1.03);
  }

  .cover.placeholder {
    background: linear-gradient(135deg, #1c1a14, #0e0d0b 65%);
    position: relative;
  }

  .cover.placeholder::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--rule);
  }

  .date {
    margin: 0.9em 0 0.25em;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .title {
    font-size: 1.25rem;
  }

  .excerpt {
    margin: 0.5em 0 0;
    color: var(--ink-dim);
    font-size: 0.95rem;
  }
</style>
