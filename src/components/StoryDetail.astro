---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import LangSwitcher from './LangSwitcher.astro';
import SectionsMenu from './SectionsMenu.astro';
import SectionBadge from './SectionBadge.astro';
import BrandMark from './BrandMark.astro';
import Gallery from './Gallery.astro';
import { ui } from '../i18n/ui';
import { locales, localeTags, type Locale } from '../i18n/locales';
import { getHomePath, getStoryPath } from '../i18n/paths';
import { sections } from '../i18n/sections';

interface Props {
  lang: Locale;
  story: CollectionEntry<'stories'>;
}

const { lang, story } = Astro.props;
const t = ui[lang];
const { Content } = await render(story);

const formattedDate = story.data.date.toLocaleDateString(localeTags[lang], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Prev/next chapter nav: scoped to the current story's own section — each
// section reads like its own book, so chapters don't hop between sections
// (Elena's call, discussed with her spouse). A sectionless story has no
// "book" to walk, so it gets no chapter nav at all. Ordering matches the
// homepage/section-page default (oldest first); first/last chapter in the
// section simply omits the missing side.
const sectionStories = story.data.section
  ? (
      await getCollection(
        'stories',
        ({ id, data }) => id.startsWith(`${lang}/`) && data.section === story.data.section,
      )
    ).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  : [];
const currentIndex = sectionStories.findIndex((s) => s.id === story.id);
const prevStory = currentIndex > 0 ? sectionStories[currentIndex - 1] : undefined;
const nextStory =
  currentIndex >= 0 && currentIndex < sectionStories.length - 1
    ? sectionStories[currentIndex + 1]
    : undefined;

// Which locales this same story (by slug) actually exists in, so the
// language switcher can deep-link to the translation instead of always
// falling back to that locale's homepage.
const slug = story.id.slice(lang.length + 1);
const allSlugs = await getCollection('stories');
const availableLocales = locales.filter((l) => allSlugs.some((s) => s.id === `${l}/${slug}`));

// hreflang alternates for <head> and (via the sitemap) search engines —
// only the locales this story actually has a translation in.
const alternates = Object.fromEntries(availableLocales.map((l) => [l, getStoryPath(l, slug)]));
if (availableLocales.includes('en')) {
  alternates['x-default'] = getStoryPath('en', slug);
}
---

<Layout
  title={`${story.data.title} — Covent Garden Syndrome`}
  description={story.data.excerpt}
  lang={lang}
  alternates={alternates}
  image={story.data.cover}
  type="article"
  publishedTime={story.data.date.toISOString()}
  section={story.data.section ? sections[story.data.section][lang].title : undefined}
>
  <article class="story">
    <SectionsMenu lang={lang} />
    <LangSwitcher lang={lang} storySlug={slug} availableLocales={availableLocales} />

    <div class="masthead">
      <BrandMark lang={lang} />
    </div>

    <a class="back" href={getHomePath(lang)}>{t.back}</a>

    <header>
      <p class="date">{formattedDate}</p>
      {story.data.section && <SectionBadge lang={lang} sectionId={story.data.section} />}
      <h1>{story.data.title}</h1>
    </header>

    {story.data.cover && <img class="cover" src={story.data.cover} alt="" />}

    <div class="prose">
      <Content />
    </div>

    {story.data.gallery && story.data.gallery.length > 0 && <Gallery images={story.data.gallery} />}

    {
      (prevStory || nextStory) && (
        <nav class="chapter-nav" aria-label="Chapters">
          {prevStory ? (
            <a class="chapter-link" href={getStoryPath(lang, prevStory.id.slice(lang.length + 1))}>
              <span class="chapter-label">{t.prevChapter}</span>
              <span class="chapter-title">{prevStory.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {nextStory ? (
            <a class="chapter-link next" href={getStoryPath(lang, nextStory.id.slice(lang.length + 1))}>
              <span class="chapter-label">{t.nextChapter}</span>
              <span class="chapter-title">{nextStory.data.title}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>
</Layout>

<style>
  .story {
    position: relative;
    max-width: 42rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }

  .masthead {
    text-align: center;
    margin-bottom: 2rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 2.5rem;
    color: var(--ink-dim);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back:hover {
    color: var(--ink);
  }

  .date {
    margin: 0 0 0.5em;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  header :global(.section-badge) {
    margin-bottom: 0.9em;
  }

  h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
  }

  .cover {
    width: 100%;
    margin: 2.5rem 0;
    border: 1px solid var(--rule);
  }

  .prose {
    margin-top: 2.5rem;
    font-family: var(--serif);
    font-size: 1.05rem;
  }

  .prose :global(p) {
    margin: 0 0 1.4em;
  }

  .prose :global(img) {
    width: 100%;
    margin: 2em 0;
    border: 1px solid var(--rule);
    /* Tap-or-hover to enlarge: no JS needed — :hover also fires on tap for
       a plain (non-link) element on iOS/Android, so this doubles as a
       touch affordance. Scale is modest so it stays fully visible even on
       narrow phones (see the .prose overflow-x rule above). */
    cursor: zoom-in;
    position: relative;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .prose :global(img:hover) {
    transform: scale(1.4);
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.5);
    z-index: 1;
  }

  .prose :global(h2) {
    margin: 1.8em 0 0.6em;
    font-size: 1.4rem;
  }

  .prose :global(h3) {
    margin: 1.6em 0 0.5em;
    font-size: 1.1rem;
    color: var(--accent);
  }

  .chapter-nav {
    display: flex;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .chapter-link {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    text-decoration: none;
    color: inherit;
    padding: 1rem;
    border: 1px solid var(--rule);
    transition: border-color 0.2s ease;
  }

  .chapter-link:hover {
    border-color: var(--accent);
  }

  .chapter-link.next {
    text-align: right;
    align-items: flex-end;
  }

  .chapter-label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .chapter-title {
    font-family: var(--serif);
    font-size: 1.05rem;
  }

  .chapter-link:hover .chapter-title {
    color: var(--accent);
  }

  @media (max-width: 32rem) {
    .chapter-nav {
      flex-direction: column;
    }

    .chapter-link.next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
