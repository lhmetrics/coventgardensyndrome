---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import LangSwitcher from './LangSwitcher.astro';
import SectionsMenu from './SectionsMenu.astro';
import { ui } from '../i18n/ui';
import { localeTags, type Locale } from '../i18n/locales';
import { getHomePath } from '../i18n/paths';

interface Props {
  lang: Locale;
  story: CollectionEntry<'stories'>;
}

const { lang, story } = Astro.props;
const t = ui[lang];
const { Content } = await render(story);

const formattedDate = story.data.date.toLocaleDateString(localeTags[lang], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout
  title={`${story.data.title} — Covent Garden Syndrome`}
  description={story.data.excerpt}
  lang={lang}
>
  <article class="story">
    <SectionsMenu lang={lang} />
    <LangSwitcher lang={lang} />
    <a class="back" href={getHomePath(lang)}>{t.back}</a>

    <header>
      <p class="date">{formattedDate}</p>
      <h1>{story.data.title}</h1>
    </header>

    {story.data.cover && <img class="cover" src={story.data.cover} alt="" />}

    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .story {
    position: relative;
    max-width: 42rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 2.5rem;
    color: var(--ink-dim);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back:hover {
    color: var(--ink);
  }

  .date {
    margin: 0 0 0.5em;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
  }

  .cover {
    width: 100%;
    margin: 2.5rem 0;
    border: 1px solid var(--rule);
  }

  .prose {
    margin-top: 2.5rem;
    font-family: var(--serif);
    font-size: 1.05rem;
  }

  .prose :global(p) {
    margin: 0 0 1.4em;
  }

  .prose :global(img) {
    width: 100%;
    margin: 2em 0;
    border: 1px solid var(--rule);
  }

  .prose :global(h2) {
    margin: 1.8em 0 0.6em;
    font-size: 1.4rem;
  }
</style>
