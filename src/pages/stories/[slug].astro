---
import { getCollection } from 'astro:content';
import StoryDetail from '../../components/StoryDetail.astro';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ id }) => id.startsWith('en/'));
  return stories.map((story) => ({
    params: { slug: story.id.slice('en/'.length) },
    props: { story },
  }));
}

const { story } = Astro.props;
---

<StoryDetail lang="en" story={story} />
