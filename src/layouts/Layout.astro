---
import { defaultLocale, locales, localeTags, type Locale } from '../i18n/locales';

interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  // Map of locale -> path (e.g. from getHomePath/getStoryPath/getSectionPath),
  // for hreflang alternate links. An 'x-default' key is also accepted, for
  // the language-neutral fallback search engines use when none of a
  // visitor's languages match.
  alternates?: Partial<Record<Locale | 'x-default', string>>;
  // Absolute or root-relative path to a representative image (og:image /
  // twitter:image). Falls back to the site's default hero photo.
  image?: string;
  // 'article' for a single story, 'website' for everything else
  // (homepage, section index pages).
  type?: 'website' | 'article';
  // article:* tags — only meaningful (and only rendered) when type is
  // 'article'. publishedTime is an ISO 8601 string; section is that
  // story's section title in the current locale.
  publishedTime?: string;
  section?: string;
}

const {
  title,
  description = 'Covent Garden Syndrome — a personal journal of stories and photographs.',
  lang = defaultLocale,
  alternates,
  image = '/photos/hero.jpg',
  type = 'website',
  publishedTime,
  section,
} = Astro.props;

const canonicalPath = alternates?.[lang];
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const ogLocale = localeTags[lang].replace('-', '_');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The site itself runs zero client-side JS and loads nothing
         cross-origin, so this can be locked down hard. (Doesn't cover
         /admin/ — Sveltia CMS needs its own, separate policy — and
         GitHub Pages can't send a real header, so frame-ancestors/
         X-Frame-Options protection isn't achievable from here; that
         would need a proxying layer in front, e.g. Cloudflare.) -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self';"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Bing Webmaster Tools site verification (alternative to
         public/BingSiteAuth.xml — Bing accepts either). -->
    <meta name="msvalidate.01" content="BF6E5023F915CEE7FB4D9098C7CDCDF6" />
    <link rel="canonical" href={canonicalURL} />
    {
      alternates &&
        Object.entries(alternates).map(([hreflang, href]) => (
          <link rel="alternate" hreflang={hreflang} href={new URL(href, Astro.site)} />
        ))
    }

    <!-- Open Graph -->
    <meta property="og:site_name" content="Covent Garden Syndrome" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content={ogLocale} />
    {
      alternates &&
        locales
          .filter((l) => l !== lang && alternates[l])
          .map((l) => <meta property="og:locale:alternate" content={localeTags[l].replace('-', '_')} />)
    }
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && section && <meta property="article:section" content={section} />}

    <!-- Twitter Card (no @handle configured — this is a personal project,
         not a brand account) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Fraunces';
    src: local('Georgia');
    font-display: swap;
  }

  :root {
    --bg: #0e0d0b;
    --bg-raised: #16140f;
    --ink: #e7e1d3;
    --ink-dim: #a49c89;
    --accent: #c9a24b;
    --turquoise: #3fb4d2;
    --rule: #2a271f;
    --serif: Georgia, 'Times New Roman', 'Iowan Old Style', serif;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    --script: 'Apple Chancery', 'Lucida Handwriting', 'Brush Script MT', cursive;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    /* Global safety net against any accidental horizontal overflow (e.g.
       the hover-zoom on story images, see StoryDetail.astro) — clip at
       the actual viewport edge, not some narrow content column's edge. */
    overflow-x: hidden;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3 {
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: 0.01em;
    margin: 0;
  }

  a {
    color: inherit;
  }

  img {
    display: block;
    max-width: 100%;
  }
</style>
